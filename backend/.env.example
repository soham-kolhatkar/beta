ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://geoattend:geoattend@localhost:5432/geoattend

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

REDIS_URL=redis://localhost:6379/0

